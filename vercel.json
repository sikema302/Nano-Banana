{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs22.x",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "excludeFiles": [
    "node_modules/sql.js/**"
  ]
}
