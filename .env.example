# VISIONARY_API_KEY: Used by the local Express proxy server.
# Copy this file to `.env.local` and replace the value with your own key.
VISIONARY_API_KEY="MY_VISIONARY_API_KEY"

# GEMINI_API_KEY / VITE_GEMINI_API_KEY are legacy fallbacks and can be omitted.
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# Supabase Auth is used for user storage and login.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
