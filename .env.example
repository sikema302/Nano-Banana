# Visionary keys used by the local Express proxy server.
# Copy this file to `.env.local` and replace the value with your own key.
VISIONARY_API_KEY="MY_LEGACY_OR_FALLBACK_VISIONARY_API_KEY"
VISIONARY_BANANA_PRO_API_KEY="MY_BANANA_PRO_KEY"
VISIONARY_NANO_LITE_API_KEY="MY_BANANA_1K_LITE_KEY"
VISIONARY_GPT_IMAGE_2_API_KEY="MY_GPT_IMAGE_2_STANDARD_KEY"
VISIONARY_GPT_IMAGE_2_HD_API_KEY="MY_GPT_IMAGE_2_2K_4K_KEY"

# Flux banana channel. Gemini image calls use the native generateContent API.
FLUX_BANANA_API_BASE_URL="https://api.ai-media.vip"
FLUX_BANANA_API_KEY=""
FLUX_BANANA_TIMEOUT_MS="900000"

# Previous Chat2API primary integration (disabled):
# CHAT2API_PRIMARY_ENABLED="false"
# CHAT2API_BASE_URL="http://127.0.0.1:5005"
# CHAT2API_AUTHORIZATION=""

# Preferred GPT-image-2 provider. On quota, auth, timeout, network, or response
# errors the server automatically falls back to the existing Visionary provider.
JUNLIAI_PRIMARY_ENABLED="true"
JUNLIAI_BASE_URL="https://img.junliai.org"
JUNLIAI_API_KEY=""
JUNLIAI_MODEL="firefly-gpt-image-2"
JUNLIAI_TIMEOUT_MS="900000"
JUNLIAI_FAILURE_THRESHOLD="1"
JUNLIAI_TRANSIENT_COOLDOWN_MS="30000"
JUNLIAI_QUOTA_COOLDOWN_MS="30000"
JUNLIAI_AUTH_COOLDOWN_MS="30000"
IMAGE_CHANNEL_RETRY_COOLDOWN_MS="30000"
DATABASE_PROVIDER="sqlite"
BUSINESS_BACKUP_DIR="./data/business-backups"
BUSINESS_BACKUP_INTERVAL_HOURS="24"
BUSINESS_BACKUP_STARTUP_MAX_AGE_HOURS="6"
BUSINESS_BACKUP_RETENTION_COUNT="30"
VISIONARY_DOC_SYNC_INTERVAL_HOURS="72"
# Optional. Falls back to JWT_SECRET or SUPABASE_SERVICE_ROLE_KEY.
BACKUP_ENCRYPTION_KEY=""
CORS_ORIGIN="http://localhost:3000"
VITE_API_BASE_URL=""
# 链动小铺优惠券：线上优先读取数据库券码池，以下文件作为本地后备。
PROMO_COUPON_95_URL="https://pay.ldxp.cn/shop/RHPYAKWG"
PROMO_COUPON_95_CODES_FILE="./data/promo-coupon-codes/95.txt"
PROMO_COUPON_90_URL="https://pay.ldxp.cn/shop/RHPYAKWG"
PROMO_COUPON_90_CODES_FILE="./data/promo-coupon-codes/90.txt"
IMAGE_RETENTION_DAYS="2"
IMAGE_CLEANUP_INTERVAL_MS="21600000"

# Cloudflare R2 generated-image storage. Leave every value empty to use local uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Allow the same account to remain signed in on multiple devices. Set to false
# to restore the previous behavior where a new login invalidates older sessions.
ALLOW_MULTI_DEVICE_LOGIN="true"
# Public async image API: accept up to 100 unfinished tasks and run 2 at once.
PUBLIC_ASYNC_MAX_PENDING="100"
PUBLIC_ASYNC_CONCURRENCY="2"

# Shared image/video admission queue. Existing work is never interrupted; new
# work waits while CPU, memory, or event-loop pressure remains above thresholds.
GENERATION_MAX_PENDING="100"
GENERATION_MAX_CONCURRENCY="3"
VIDEO_MAX_CONCURRENCY="1"
RESOURCE_SAMPLE_INTERVAL_MS="2000"
RESOURCE_CPU_PAUSE_PERCENT="85"
RESOURCE_CPU_RESUME_PERCENT="65"
RESOURCE_MEMORY_PAUSE_PERCENT="85"
RESOURCE_MEMORY_RESUME_PERCENT="75"
RESOURCE_MIN_AVAILABLE_MEMORY_MB="300"
RESOURCE_RESUME_AVAILABLE_MEMORY_MB="500"
RESOURCE_EVENT_LOOP_PAUSE_MS="200"
RESOURCE_EVENT_LOOP_RESUME_MS="100"
RESOURCE_PAUSE_SAMPLES="5"
RESOURCE_RESUME_SAMPLES="10"

# Server-side key used by PIXORY-CHAT. Never expose this key in VITE_* variables.
GEMINI_API_KEY=""
# Optional Gemini text model override.
CHAT_MODEL="gemini-3.5-flash"

# Optional Supabase provider and migration source. These are not required when
# DATABASE_PROVIDER=sqlite unless a migration or reverse sync is being run.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
